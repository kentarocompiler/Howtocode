void resetData() {
    int confirm;
    cout << "\n!!! WARNING: RESET ALL DATA !!!\n1. Confirm / 2. Cancel: "; cin >> confirm;
    if (confirm == 1) {
        for (int i = 0; i < (int)tables.size(); i++) {
            tables[i].List.clear(); tables[i].Price.clear(); tables[i].Amount.clear();
            tables[i].count = 0; tables[i].total = 0;
        }
        fill(useTable.begin(), useTable.end(), 0);
        cout << ">>> RESET COMPLETED <<<" << endl;
    }
}

